# Build on/for linux/amd64; the runtime needs an NVIDIA driver + Container Toolkit on the host.
FROM node:22-bookworm-slim AS browser
WORKDIR /build
COPY web/sim/package*.json ./
RUN npm ci
COPY web/sim/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS sim-base
COPY --from=ghcr.io/astral-sh/uv:0.9.8 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 libgl1 libgles2 libvulkan1 libx11-6 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '%s\n' '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
       > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
WORKDIR /app
ENV MUJOCO_GL=egl \
    SIM_RENDERER=filament \
    PORTAL_PROFILE=widowx \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,video \
    PATH=/app/.venv/bin:$PATH
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group sim --no-install-project
COPY src/ ./src/
COPY portal.yaml ./
COPY assets/widowx/ ./assets/widowx/
COPY assets/workbench/ ./assets/workbench/
COPY assets/robocasa/ ./assets/robocasa/
COPY assets/yam/ ./assets/yam/
COPY --from=browser /build/dist ./web/sim/dist
EXPOSE 8080
HEALTHCHECK --interval=15s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz')"
CMD ["python", "-m", "robot_sim", "--host", "0.0.0.0"]

FROM sim-base AS dream
RUN uv sync --frozen --only-group sim-dream --no-install-project
HEALTHCHECK NONE
CMD ["python", "-m", "policies.dream_1_tasks.run"]

# Keep a plain `docker build` simulation-only; Compose selects the optional dream target explicitly.
FROM sim-base AS sim
